# RouterAI (OpenAI-compatible). Never expose these to the browser.
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-large

# App
APP_ENV=development
APP_VERSION=dev
DEMO_PASSWORD=creditlens-demo
SECRET_KEY=change-me-in-production
DATABASE_PATH=data/creditlens.db
QDRANT_URL=http://127.0.0.1:6333
OBSERVABILITY=both
MAX_AGENT_STEPS=12
AGENT_TIMEOUT_SEC=60
MAX_OUTPUT_TOKENS=1200

# Langfuse OSS (self-hosted). Same keys as LANGFUSE_INIT_* in compose.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=lf_pk_creditlens_demo
LANGFUSE_SECRET_KEY=lf_sk_creditlens_demo

# LangSmith SaaS — optional. Adapter is ready; without a key the UI says ready_no_key.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=creditlens
LANGSMITH_TRACING=true

# Optional VM bootstrap (not used by the app)
VM_IP=
VM_LOGIN=
VM_PASSWORD=
