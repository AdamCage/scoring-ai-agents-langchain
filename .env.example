# RouterAI (OpenAI-compatible). Never expose these to the browser.
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-large

# App
APP_ENV=development
APP_VERSION=dev
DEMO_PASSWORD=creditlens-demo
SECRET_KEY=change-me-in-production
DATABASE_PATH=data/creditlens.db
QDRANT_URL=http://127.0.0.1:6333
OBSERVABILITY=local
MAX_AGENT_STEPS=12
AGENT_TIMEOUT_SEC=60
MAX_OUTPUT_TOKENS=1200

# Optional VM bootstrap (not used by the app)
VM_IP=
VM_LOGIN=
VM_PASSWORD=
