flowchart TD
  startNode[START]
  validate[validate_application]
  needInfo[request_information_INTERRUPT]
  scoreNode[calculate_score_tool]
  shapNode[explain_score_SHAP]
  retrieveNode[retrieve_policy_hybrid_RAG]
  riskAgent[risk_analyst_agent]
  criticAgent[policy_critic_agent]
  moreRag[retrieve_more]
  synthAgent[final_synthesizer]
  humanReview[human_review]
  endNode[END]

  startNode --> validate
  validate -->|invalid| needInfo --> endNode
  validate -->|valid| scoreNode
  scoreNode --> shapNode
  scoreNode --> retrieveNode
  shapNode --> riskAgent
  retrieveNode --> riskAgent
  riskAgent --> criticAgent
  criticAgent -->|insufficient| moreRag --> riskAgent
  criticAgent -->|acceptable| synthAgent
  synthAgent --> humanReview --> endNode
